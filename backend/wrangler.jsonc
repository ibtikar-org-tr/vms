{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "membership-app-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-31",
  "account_id": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
  "d1_databases": [
    {
      "binding": "MEMBERS_DB",
      "database_name": "membership-app-database",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "remote": true,
      "migrations_dir": "../database/members"
    },
    {
      "binding": "VMS_DB",
      "database_name": "vms-database",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "remote": true,
      "migrations_dir": "../database/vms/migrations"
    },
    {
      "binding": "VMS_LOGS_DB",
      "database_name": "vms-logs-database",
      "database_id": "00000000-0000-0000-0000-000000000002",
      "remote": true,
      "migrations_dir": "../database/logs/migrations"
    }
  ],
  "triggers": {
    "crons": ["*/15 4-18 * * *"]
  },
  "r2_buckets": [
    {
      "binding": "MY_BUCKET",
      "bucket_name": "membership-app-bucket",
      "remote": true
    }
  ],
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "vectorize": [
    {
      "binding": "VMS_NOTES_VECTORIZE",
      "index_name": "vms-project-notes",
      "remote": true
    }
  ],
  "services": [
    {
      "binding": "TELEGRAM_MS_SERVICE",
      "service": "telegram-ms",
      "remote": true
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "ASSEMBLY_ANNOUNCEMENT_QUEUE",
        "queue": "membership-app-backend-assembly-announcements"
      }
    ],
    "consumers": [
      {
        "queue": "membership-app-backend-assembly-announcements",
        "dead_letter_queue": "membership-app-backend-assembly-announcements-dlq",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 8,
        "max_concurrency": 1,
        "retry_delay": 15
      }
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PROJECT_NOTE_ROOM",
        "class_name": "ProjectNoteRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-project-notes",
      "new_sqlite_classes": ["ProjectNoteRoom"]
    }
  ],
  "vars": {
    "MEMBERSHIP_NUMBER_PREFIX": "2501",
    "TELEGRAM_MS":"https://ibtikar.tr/ms/telegram",
    "FRONTEND_BASE_URL":"https://ibtikar.tr",
    "CORS_ALLOW_ORIGINS":"https://ibtikar.tr",
    "INTERNAL_SECRET":"delete-on-deployment",
    "JWT_SECRET":"delete-on-deployment",
    "SMTP_HOST": "",
    "SMTP_PORT": "587",
    "SMTP_USER": "",
    "SMTP_PASS": "delete-on-deployment",
    "AUTHDEEP_API_BASE": "https://api.authdeep.com",
    "AUTHDEEP_TENANT_ID": "0bc3ef3f-d5ed-4281-8e1c-fd6e8519f77a",
    "AUTHDEEP_MAIL_FROM": "noreply@ibtikar.tr",
    "CRON_TIMEZONE": "Europe/Istanbul",
    "CRON_DRY_RUN": "false"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "dev": {
    "port": 5931,
    "ip": "0.0.0.0"
  }
}