VITE_BASE_PATH=/.
VITE_SITE_URL=https://ibtikar.tr
VITE_MEMBER_MS=https://dev.ibtikar.tr/ms/membership-app
VITE_CHATBOT_MS=https://dev.ibtikar.tr/ms/chatbot

# External SSO redirect origins are enforced by the backend
# (EXTERNAL_AUTH_REDIRECT_ORIGINS). Examples:
#   /login?client=kitchen&redirect_uri=https://kitchen-host/auth/callback
#   /login?client=career&redirect_uri=http://localhost:9692/auth/callback
#   /login?client=career&redirect_uri=https://ibtikar-career.ctf.web.tr/auth/callback
#
# Deployed backends must include the career FE origin in EXTERNAL_AUTH_REDIRECT_ORIGINS
# (GitHub env var on backend deploy), e.g.:
#   ...,https://ibtikar-career.ctf.web.tr

