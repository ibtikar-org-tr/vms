{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ibtikar-career-be",
  "main": "src/index.ts",
  "compatibility_date": "2025-12-01",
  "dev": {
    "port": 9690
  },
  "vars": {
    "APP_NAME": "ibtikar-career",
    "VMS_API_BASE": "http://localhost:5931/ms/membership-app/api"
  },
  "d1_databases": [
    {
      "binding": "D1_DB",
      "database_name": "ibtikar-career",
      "database_id": "00000000-0000-0000-0000-000000000010",
      "migrations_dir": "migrations"
    },
    {
      "binding": "MEMBERS_DB",
      "database_name": "membership-app-database-local",
      "database_id": "11111111-1111-1111-1111-111111111111"
    },
    {
      "binding": "VMS_DB",
      "database_name": "vms-database-local",
      "database_id": "22222222-2222-2222-2222-222222222222"
    }
  ],
  "r2_buckets": [
    {
      "binding": "CAREER_BUCKET",
      "bucket_name": "ibtikar-career-bucket"
    }
  ]
}
